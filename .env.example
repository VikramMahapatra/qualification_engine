APP_NAME="Qualification & Lead Scoring Engine"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
# PostgreSQL: set these values in .env, never commit real credentials.
DB_USER=your_database_user
DB_PASS='your_database_password'
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qualification_engine_dev
DB_SSLMODE=require
DB_CONNECT_TIMEOUT_SECONDS=10
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
# Optional override for local SQLite or another SQLAlchemy URL:
# DATABASE_URL=sqlite:///./data/qualification_engine.db
ADMIN_API_KEY=change-me-admin-key
LOG_LEVEL=INFO

# rule_based | llm | hybrid
ANALYZER=rule_based
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
